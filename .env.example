# ==============================================================================
# RED LAB COLLABORATION PLATFORM - KÖRNYEZETI VÁLTOZÓK (.env.example)
# ==============================================================================

# 1. Supabase Adatbázis & Autentikáció
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 2. Alkalmazás Alap URL (Webhookokhoz és Email közvetlen linkekhez)
NEXT_PUBLIC_APP_URL=https://your-redlab-app.domain.com

# 3. Discord / Slack Webhook Integráció
# Ide másold be a Discord csatornád Webhook URL-jét (Integrációk > Webhook)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# 4. Témavezetői Email Értesítési Szolgáltatás (Resend API)
# Ingyenesen regisztrálható API kulcs a https://resend.com oldalon
RESEND_API_KEY=re_your_resend_api_key_here

# 5. Opcionális: Rendszergazda és Témavezető Alapértelmezett Email Címe
SUPERVISOR_DEFAULT_EMAIL=prof.kovacs@redlab.bme.hu

# 6. Google Gemini AI API Kulcs (AI Research Co-Pilot)
GEMINI_API_KEY=your-gemini-api-key-here

